commodity CAD
  format 1.00 CAD

account Assets:Bank
account Income:Salary
account Expenses:Food
account Expenses:Rent

2000 ACME
  Bank 1,000 CAD
  Salary

2000/02 Loeb
  Food
  Bank -20 CAD

2000/03/03 
  Rent 500 CAD
  Bank

; default format: normalizes dates, aligns accounts and amounts, fills in omitted posting amount
test format
2000/01/01 ACME
  Assets:Bank     1000.00 CAD
  Income:Salary  -1000.00 CAD

2000/02/01 Loeb
  Expenses:Food   20.00 CAD
  Assets:Bank    -20.00 CAD

2000/03/03 
  Expenses:Rent   500.00 CAD
  Assets:Bank    -500.00 CAD

end test

; -ts prints amounts with thousand separators
test format -ts
2000/01/01 ACME
  Assets:Bank     1,000.00 CAD
  Income:Salary  -1,000.00 CAD

2000/02/01 Loeb
  Expenses:Food   20.00 CAD
  Assets:Bank    -20.00 CAD

2000/03/03 
  Expenses:Rent   500.00 CAD
  Assets:Bank    -500.00 CAD

end test
