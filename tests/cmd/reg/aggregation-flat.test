include basic.coin

; aggregate leaf account postings by month (-m)
test register -m Food
Expenses:Food CAD
        |   Food
2010/01 | 250.00
2010/02 | 100.00
2010/03 | 200.00
2010/05 | 300.00
2010/06 | 250.00
2010/07 | 300.00
end test

; aggregate postings by quarter (-q)
test register -q Salary
Income:Salary CAD
        |   Salary
2010/01 | -3000.00
2010/04 | -3000.00
2010/07 | -1000.00
end test

; aggregate postings by year (-y)
test register -y Salary
Income:Salary CAD
     |   Salary
2010 | -7000.00
end test

; aggregate postings by week (-w), labeled by week start date
test register -w Rent
Expenses:Rent CAD
           |   Rent
2010/01/24 | 500.00
2010/02/28 | 500.00
2010/03/28 | 500.00
2010/04/25 | 500.00
2010/05/30 | 500.00
2010/06/27 | 500.00
2010/07/25 | 500.00
end test

; without -r, subaccount columns are shown separately without rolling into parent
test register -m Expenses
Expenses CAD
        |  :Rent |  :Food | Expenses
2010/01 | 500.00 | 250.00 |     0.00
2010/02 | 500.00 | 100.00 |     0.00
2010/03 | 500.00 | 200.00 |     0.00
2010/04 | 500.00 |   0.00 |     0.00
2010/05 | 500.00 | 300.00 |     0.00
2010/06 | 500.00 | 250.00 |     0.00
2010/07 | 500.00 | 300.00 |     0.00
end test

; -c accumulates totals across time periods
test register -m -c Expenses
Expenses CAD
        |   :Rent |   :Food | Expenses
2010/01 |  500.00 |  250.00 |     0.00
2010/02 | 1000.00 |  350.00 |     0.00
2010/03 | 1500.00 |  550.00 |     0.00
2010/04 | 2000.00 |  550.00 |     0.00
2010/05 | 2500.00 |  850.00 |     0.00
2010/06 | 3000.00 | 1100.00 |     0.00
2010/07 | 3500.00 | 1400.00 |     0.00
end test

;
; Aggregating by category
;

; aggregate postings by payee (-bp)
test register -bp Expenses
Expenses CAD
             |   :Rent |   :Food | Expenses
     Freshco |    0.00 | 1400.00 |     0.00
Housing Corp | 3500.00 |    0.00 |     0.00
end test

; 2D aggregation: quarterly time periods (-q) and payees (-bp)
test register -bp -q Expenses
Expenses CAD
        |              |   :Rent |  :Food | Expenses
2010/01 |      Freshco |    0.00 | 550.00 |     0.00
2010/01 | Housing Corp | 1500.00 |   0.00 |     0.00
2010/04 |      Freshco |    0.00 | 550.00 |     0.00
2010/04 | Housing Corp | 1500.00 |   0.00 |     0.00
2010/07 |      Freshco |    0.00 | 300.00 |     0.00
2010/07 | Housing Corp |  500.00 |   0.00 |     0.00
end test


; aggregate postings by tag (-bt), including <no-tags> for untagged postings
test register -bt Food
Expenses:Food CAD
               |   Food
     <no-tags> | 400.00
 fruits:apples | 100.00
fruits:bananas | 200.00
fruits:berries | 300.00
       veggies | 400.00
end test

; -bt with tag filter (-t) restricts to matching tag categories
test register -bt -t fruits Food
Expenses:Food CAD
               |   Food
 fruits:apples | 100.00
fruits:bananas | 200.00
fruits:berries | 300.00
end test

; 2D aggregation: monthly time periods (-m) broken down by tag (-bt)
test register -bt -m Food
Expenses:Food CAD
        |                |   Food
2010/01 |  fruits:apples | 100.00
2010/01 |        veggies | 150.00
2010/02 |      <no-tags> | 100.00
2010/03 | fruits:bananas | 200.00
2010/05 |      <no-tags> | 300.00
2010/06 |        veggies | 250.00
2010/07 | fruits:berries | 300.00
end test
