include basic.coin

; monthly aggregation
test register -m -o csv Expenses
Date,:Rent,:Food,Expenses
2010/01,500.00,250.00,0.00
2010/02,500.00,100.00,0.00
2010/03,500.00,200.00,0.00
2010/04,500.00,0.00,0.00
2010/05,500.00,300.00,0.00
2010/06,500.00,250.00,0.00
2010/07,500.00,300.00,0.00
end test

; tag aggregation
test register -bt -o csv Expenses
Category,:Rent,:Food,Expenses
<no-tags>,3500.00,400.00,0.00
fruits:apples,0.00,100.00,0.00
fruits:bananas,0.00,200.00,0.00
fruits:berries,0.00,300.00,0.00
veggies,0.00,400.00,0.00
end test

; quarterly (-q) and by payee (-bp) aggregation
test register -r -q -bp -o csv Expenses
Date,Category,Expenses,:Rent,:Food
2010/01,Freshco,550.00,0.00,550.00
2010/01,Housing Corp,1500.00,1500.00,0.00
2010/04,Freshco,550.00,0.00,550.00
2010/04,Housing Corp,1500.00,1500.00,0.00
2010/07,Freshco,300.00,0.00,300.00
2010/07,Housing Corp,500.00,500.00,0.00
end test
