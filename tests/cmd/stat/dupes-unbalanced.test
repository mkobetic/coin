commodity CAD
  format 1.00 CAD

account Assets:Bank
account Expenses:Food

2020/01/01 Store
  Expenses:Food 25 CAD
  Assets:Bank

2020/01/01 Store
  Expenses:Food 25 CAD
  Assets:Bank

2020/01/02 Mystery
  Assets:Bank -50 CAD
  Unbalanced

; -d reports identical transactions posted on the same day
test stats -d
DUPLICATE TRANSACTION?
tests/cmd/stat/dupes-unbalanced.test:7
2020/01/01 Store
  Expenses:Food   25.00 CAD
  Assets:Bank    -25.00 CAD

tests/cmd/stat/dupes-unbalanced.test:11
2020/01/01 Store
  Expenses:Food   25.00 CAD
  Assets:Bank    -25.00 CAD

end test

; -u reports transactions with postings to the Unbalanced account
test stats -u
UNBALANCED TRANSACTION!
tests/cmd/stat/dupes-unbalanced.test:15
2020/01/02 Mystery
  Assets:Bank  -50.00 CAD
  Unbalanced    50.00 CAD

Commodities: 1
Prices: 0
Accounts: 6
Transactions: 3
end test
